  "schema_version": 1,
  "description": "Verified volunteering locations for distance estimates. Separate from opportunities.json so the original records stay unchanged. Session 12 adds organization_locations (one verified physical site per organization, or none when there are several or only a P.O. box) and, for home-based roles, travel notes with evidence.",
  "location_status_values": {
    "verified_site": "An official page places this role at the site, and the site's street address is published. Coordinates allowed.",
    "candidate_site_unconfirmed": "A likely site exists but no official page says the role happens there. No distance is calculated.",
    "volunteer_home": "The role happens in the volunteer's own home (fostering). No distance to the activity; a related site (orientation, supply pickup) is shown only when a source says so.",
    "not_published": "No dependable volunteering location. No distance is calculated."
  },
  "verification": {
    "verified_on": "2026-10-25",
    "method": "Official organization pages were fetched again on 2026-10-25 and the quoted text was found on each page (see accessed_at). Mailing addresses and P.O. boxes are never used.",
