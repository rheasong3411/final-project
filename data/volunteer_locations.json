  },
  "geocoding_method": {
    "service": "U.S. Census Geocoder REST API, /geocoder/locations/onelineaddress",
    "url": "https://geocoding.geo.census.gov/geocoder/locations/onelineaddress",
    "benchmark": "Public_AR_Current",
    "permissions": "Public U.S. Census Bureau service; no key or account required. Results are U.S. Government works (public domain in the U.S., 17 U.S.C. 105).",
    "documentation": [
      "https://www.census.gov/programs-surveys/geography/technical-documentation/complete-technical-documentation/census-geocoder.html",
      "https://geocoding.geo.census.gov/geocoder/Geocoding_Services_API.html"
    ],
    "how_coordinates_are_made": "Census documentation: 'Coordinate results are interpolated, or approximated, based on the physical location that the address geocoded on the TIGER address ranges.'",
    "uncertainty": "An interpolated street-address point can be off by tens to a few hundred meters, and a large property (for example The Animal Haven's seven acres) is reduced to one point. Shown distances are rounded to at least half a mile, which is coarser than this error.",
    "accepted_matches": "Exactly one match per address; otherwise coordinates stay null."
  },
